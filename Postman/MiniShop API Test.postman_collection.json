      "item": [
        {
          "name": "Get Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst products = pm.response.json();\r\n\r\npm.test(\"Response is an array\", function () {\r\n    pm.expect(products).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Response contains 3 products\", function () {\r\n    pm.expect(products).to.have.lengthOf(3);\r\n});\r\n\r\npm.test(\"Each product has required fields\", function () {\r\n    products.forEach(function (product) {\r\n        pm.expect(product).to.have.property(\"id\");\r\n        pm.expect(product).to.have.property(\"name\");\r\n        pm.expect(product).to.have.property(\"price\");\r\n        pm.expect(product).to.have.property(\"inStock\");\r\n    });\r\n});\r\n\r\npm.test(\"Product fields have correct data types\", function () {\r\n    products.forEach(function (product) {\r\n        pm.expect(product.id).to.be.a(\"number\");\r\n        pm.expect(product.name).to.be.a(\"string\");\r\n        pm.expect(product.price).to.be.a(\"number\");\r\n        pm.expect(product.inStock).to.be.a(\"boolean\");\r\n    });\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://minishop.example.com/products",
              "protocol": "https",
              "host": [
                "minishop",
                "example",
                "com"
              ],
              "path": [
                "products"
              ]
            }
          },
