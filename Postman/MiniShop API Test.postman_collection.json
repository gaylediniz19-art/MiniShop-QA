              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Response contains required fields\", function () {\r\n    pm.expect(response).to.have.property(\"orderId\");\r\n    pm.expect(response).to.have.property(\"status\");\r\n    pm.expect(response).to.have.property(\"total\");\r\n    pm.expect(response).to.have.property(\"estimatedDelivery\");\r\n});\r\n\r\npm.test(\"orderId is a string\", function () {\r\n    pm.expect(response.orderId).to.be.a(\"string\");\r\n});\r\n\r\npm.test(\"status is a string\", function () {\r\n    pm.expect(response.status).to.be.a(\"string\");\r\n});\r\n\r\npm.test(\"total is a number\", function () {\r\n    pm.expect(response.total).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"estimatedDelivery is a string\", function () {\r\n    pm.expect(response.estimatedDelivery).to.be.a(\"string\");\r\n});\r\n\r\npm.test(\"Order status is confirmed\", function () {\r\n    pm.expect(response.status).to.eql(\"confirmed\");\r\n});\r\n\r\npm.test(\"Order total is correct\", function () {\r\n    pm.expect(response.total).to.eql(39.98);\r\n});"
